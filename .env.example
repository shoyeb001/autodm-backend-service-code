# Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/neondb?sslmode=require

# AWS SQS Queue URL
QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/autodm-comments-queue

# Meta / Instagram Config
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=autodm_verify_token
